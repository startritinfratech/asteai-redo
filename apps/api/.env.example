# AsteAI API – Environment Variables
# Copy to .env.local and fill in values. Never commit secrets.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Number of reverse proxies in front of the API (1 behind an AWS ALB; 2 with CloudFront
# in front of the ALB). Makes req.ip the real client IP (contract signatures, rate limits).
# Leave blank or 0 when clients connect directly: X-Forwarded-For is then ignored.
TRUST_PROXY=

# ── Database (AWS RDS PostgreSQL) ─────────────────────────────────────────────
DATABASE_HOST=your-instance.xxxxxxxx.ap-south-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=asteai
DATABASE_USER=asteai_app
DATABASE_PASSWORD=           # leave blank when DATABASE_IAM_AUTH=true
DATABASE_IAM_AUTH=true
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false  # RDS uses AWS CA not in Node's default trust store
DATABASE_MAX_POOL=20
DATABASE_IDLE_TIMEOUT_MS=30000

# ── AWS (for IAM token generation) ───────────────────────────────────────────
AWS_REGION=ap-south-1

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encrypts two-factor (TOTP) secrets at rest (AES-256-GCM, key derived with HKDF).
# Required in production; at least 32 random characters, different from JWT_SECRET.
# Changing it makes existing 2FA enrolments unreadable (users must enrol again).
# In development it falls back to a key derived from JWT_SECRET, with a warning.
TOTP_ENCRYPTION_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── AI Service (deeptech_ai) ──────────────────────────────────────────────────
# Server-to-server base URL, and the one the browser uses for the interview
# WebSocket (defaults to AI_SERVICE_URL). deeptech_ai must allow the web origin in CORS.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PUBLIC_URL=
# = deeptech_ai AI_API_KEY
AI_SERVICE_API_KEY=
# = deeptech_ai JWT_SECRET. Signs the short-lived token the browser sends to the AI
# service; keep it different from JWT_SECRET so the AI service cannot mint logins.
AI_JWT_SECRET=
AI_TOKEN_TTL_SECONDS=1800
# = deeptech_ai ASTEAI_RESULTS_KEY. deeptech_ai posts results to
# <this API>/api/v1/internal/ai-results with it (set its ASTEAI_RESULTS_URL to that).
ASTEAI_RESULTS_KEY=

# ── Certificates ──────────────────────────────────────────────────────────────
# Printed on each certificate as <PUBLIC_WEB_URL>/verify/certificate/<id>
PUBLIC_WEB_URL=http://localhost:3000
# Folder holding logo.png (defaults to apps/api/assets when run from apps/api)
CERTIFICATE_ASSET_DIR=

# ── Payments ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks: https://<api>/api/v1/payments/razorpay/webhook, events payment.authorized,
# payment.captured, payment.failed, order.paid, refund.processed, refund.failed. Auto-capture must be on.
RAZORPAY_WEBHOOK_SECRET=

# Voice assistant (POST /assistant/command). Without a key the endpoint returns 503.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# ── Email ─────────────────────────────────────────────────────────────────────
# ses: send through AWS SES v2 (credentials from the task role / default chain;
# the sender's domain must be verified in SES). log: write emails to the log instead.
EMAIL_TRANSPORT=log
EMAIL_FROM=AsteAI <no-reply@asteai.com>
EMAIL_REPLY_TO=
SES_CONFIGURATION_SET=
# The worker sends queued email from every API process; set false to run it elsewhere.
EMAIL_WORKER_ENABLED=true
EMAIL_POLL_MS=5000

# Dispute SLA sweep: every 10 min, disputes past their 72h response deadline go to admin
# review. Safe on several instances (a Postgres advisory lock lets one run at a time).
DISPUTE_SWEEP_ENABLED=true

# Gig sweep: every 10 min, delivered gig orders get a reminder after 5 days and are accepted
# automatically after 7; funded orders past their due date are flagged overdue. Safe on
# several instances (a Postgres advisory lock lets one run at a time).
GIG_SWEEP_ENABLED=true

# ── Payouts & invoices ────────────────────────────────────────────────────────
# Encrypts expert bank/UPI details. Required in production; 32+ chars, unique.
PAYOUT_ENCRYPTION_KEY=
PAYOUT_MIN=500
INVOICE_ISSUER_NAME=AsteAI
INVOICE_ISSUER_ADDRESS=
INVOICE_ISSUER_GSTIN=
