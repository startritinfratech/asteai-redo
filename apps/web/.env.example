NEXT_PUBLIC_API_URL=http://localhost:3001

# Realtime chat connects straight to the API (Next rewrites do not carry websockets).
NEXT_PUBLIC_WS_URL=http://localhost:3001
# Server-rendered public pages (e.g. /experts) call the API directly; in-cluster URL.
API_INTERNAL_URL=http://localhost:3001

# Cloudflare Turnstile site key for public forms and sign-up. Unset: the widget is not shown
# (the API must then also have no TURNSTILE_SECRET_KEY, i.e. development only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
